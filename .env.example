# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL / Local PostgreSQL)
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/fix_master_db?sslmode=require
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/fix_master_db"

# JWT Authentication Secrets
JWT_SECRET="REDACTED-published-example-secret"
JWT_EXPIRES_IN="24h"
