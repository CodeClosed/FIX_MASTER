# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Neon Serverless PostgreSQL / Local PostgreSQL)
# Example: postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/fix_master_db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fix_master_db"

# JWT Authentication Secrets
# IMPORTANT: this is a placeholder committed to the repo. The server refuses
# to start with NODE_ENV=production while JWT_SECRET is still this value
# (see src/server.js) because anyone with read access to the repo can forge
# tokens for any user, including ADMIN, once they know the secret. Generate
# a real one before deploying, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="fixmaster_super_secure_jwt_secret_2026_vit_deepika_j"
JWT_EXPIRES_IN="24h"

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN="http://localhost:5173,https://fixmaster.example.com"
# Leave unset for local development (all origins allowed); set this before
# deploying anywhere the API is reachable from the public internet.
CORS_ORIGIN=
